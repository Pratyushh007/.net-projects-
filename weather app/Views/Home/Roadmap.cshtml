@{
    ViewData["Title"] = "Three Stages Curriculum Roadmap";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">CURRICULUM ARCHITECTURE</span>
        <h1 class="display-5 fw-extrabold text-white">Three Stages, From Basics to the Web</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 750px;">
            Here is how all 11 projects and their core focus competencies are integrated into the <strong>Weather App</strong>.
        </p>
    </div>

    <!-- Visual 3-Stage Diagram Replicating the Image -->
    <div class="row g-4 mb-5">
        <!-- Stage 1 -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100 border-start border-4 border-info">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stage-badge-icon stage-1-icon mb-0">
                        &gt;_
                    </div>
                    <div>
                        <small class="text-info fw-bold text-uppercase">Projects 1–3</small>
                        <h3 class="h4 mb-0 text-white">Console basics</h3>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.03);">
                    <div class="fw-semibold text-white mb-2"><i class="bi bi-bullseye text-warning me-1"></i> Core Projects:</div>
                    <ul class="text-secondary small ps-3 mb-0">
                        <li class="mb-1"><strong>Number Guessing Game:</strong> Guess the Temperature game with dynamic hot/cold clues, loops, and streaks.</li>
                        <li class="mb-1"><strong>Simple Calculator:</strong> Atmospheric & thermal comfort calculator (Heat Index, Wind Chill, Dew Point, Rain harvest).</li>
                        <li><strong>Unit Converter:</strong> Multi-unit conversions for temperature, wind velocity, barometric pressure, and precipitation.</li>
                    </ul>
                </div>

                <div class="p-2 px-3 rounded-2" style="background: rgba(6, 182, 212, 0.1); border: 1px dashed rgba(6, 182, 212, 0.3);">
                    <small class="text-info">
                        <strong>Focus:</strong> Syntax, loops, conditions, methods
                    </small>
                </div>
            </div>
        </div>

        <!-- Stage 2 -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100 border-start border-4 border-primary">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stage-badge-icon stage-2-icon mb-0">
                        📦
                    </div>
                    <div>
                        <small class="text-primary fw-bold text-uppercase">Projects 4–8</small>
                        <h3 class="h4 mb-0 text-white">Data & OOP</h3>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.03);">
                    <div class="fw-semibold text-white mb-2"><i class="bi bi-boxes text-info me-1"></i> Core Projects:</div>
                    <ul class="text-secondary small ps-3 mb-0">
                        <li class="mb-1"><strong>To-Do List:</strong> Weather-smart activity planner checking tasks against real-time forecasts.</li>
                        <li class="mb-1"><strong>Student Grade Manager:</strong> City Weather Report Card scoring cities A+ to F using LINQ.</li>
                        <li class="mb-1"><strong>Quiz App:</strong> Meteorology & extreme weather interactive quiz with scoring.</li>
                        <li class="mb-1"><strong>Bank Account Simulator:</strong> Climate energy wallet tracking heating/cooling costs.</li>
                        <li><strong>Password Generator:</strong> WeatherCrypt meteorological passphrase generator.</li>
                    </ul>
                </div>

                <div class="p-2 px-3 rounded-2" style="background: rgba(99, 102, 241, 0.1); border: 1px dashed rgba(99, 102, 241, 0.3);">
                    <small class="text-primary">
                        <strong>Focus:</strong> Classes, collections, LINQ, files
                    </small>
                </div>
            </div>
        </div>

        <!-- Stage 3 -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100 border-start border-4 border-emerald" style="border-color: #10b981;">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stage-badge-icon stage-3-icon mb-0" style="background: linear-gradient(135deg, #10b981, #059669);">
                        🌐
                    </div>
                    <div>
                        <small class="text-success fw-bold text-uppercase">Projects 9–11</small>
                        <h3 class="h4 mb-0 text-white">Web & APIs</h3>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.03);">
                    <div class="fw-semibold text-white mb-2"><i class="bi bi-globe2 text-success me-1"></i> Core Projects:</div>
                    <ul class="text-secondary small ps-3 mb-0">
                        <li class="mb-1"><strong>Personal Notes Web App:</strong> EF Core SQLite weather journal with search & tagging.</li>
                        <li class="mb-1"><strong>Weather App (Hero Project):</strong> Live Open-Meteo REST API consumer, 7-day forecast, 24-hr hourly chart, GPS.</li>
                        <li><strong>Contact Book API:</strong> RESTful emergency services directory with complete CRUD endpoints.</li>
                    </ul>
                </div>

                <div class="p-2 px-3 rounded-2" style="background: rgba(16, 185, 129, 0.1); border: 1px dashed rgba(16, 185, 129, 0.3);">
                    <small class="text-success">
                        <strong>Focus:</strong> ASP.NET Core, EF Core, HTTP
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Deep Dive Integration Breakdown -->
    <div class="glass-panel p-4 p-md-5 mb-5">
        <h3 class="h4 fw-bold mb-4 text-white"><i class="bi bi-cpu me-2 text-info"></i>Architectural Competency Matrix</h3>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                    <tr class="border-secondary">
                        <th>Stage</th>
                        <th>Project Name</th>
                        <th>Weather App Implementation</th>
                        <th>Key C# / .NET Concepts Applied</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody class="border-secondary">
                    <tr>
                        <td><span class="badge bg-secondary">Stage 1</span></td>
                        <td><strong>1. Number Guessing Game</strong></td>
                        <td>Guess the Temperature in random world cities with hot/cold hints & streaks</td>
                        <td>Loops, random selection, conditions (`if/else`), methods</td>
                        <td><a asp-controller="Games" asp-action="GuessTemperature" class="btn btn-sm btn-outline-info">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-secondary">Stage 1</span></td>
                        <td><strong>2. Simple Calculator</strong></td>
                        <td>Atmospheric Calculator: Heat Index, Wind Chill, Dew Point, Rain harvest</td>
                        <td>Mathematical formulas, operator precedence, method breakdown</td>
                        <td><a asp-controller="Tools" asp-action="Calculator" class="btn btn-sm btn-outline-info">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-secondary">Stage 1</span></td>
                        <td><strong>3. Unit Converter</strong></td>
                        <td>Converts °C/°F/K/°R, km/h/mph/m/s/knots, hPa/inHg/atm, rainfall mm/in</td>
                        <td>Switch expressions, normalization via base units, rounding</td>
                        <td><a asp-controller="Tools" asp-action="Converter" class="btn btn-sm btn-outline-info">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Stage 2</span></td>
                        <td><strong>4. To-Do List</strong></td>
                        <td>Weather-Smart Activity & Packing planner linked with live forecasts</td>
                        <td>OOP classes, generic `List<T>`, state mutation, date filters</td>
                        <td><a asp-controller="Planner" asp-action="Todo" class="btn btn-sm btn-outline-primary">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Stage 2</span></td>
                        <td><strong>5. Student Grade Manager</strong></td>
                        <td>City Weather Report Card: grades weather from A+ to F with GPA & valedictorian</td>
                        <td>LINQ (`Average`, `Where`, `OrderByDescending`, `GroupBy`)</td>
                        <td><a asp-controller="Planner" asp-action="Grades" class="btn btn-sm btn-outline-primary">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Stage 2</span></td>
                        <td><strong>6. Quiz App</strong></td>
                        <td>Meteorology & Extreme Weather Quiz with instant explanations & leaderboard</td>
                        <td>Object collections, LINQ sorting, EF Core score persistence</td>
                        <td><a asp-controller="Games" asp-action="Quiz" class="btn btn-sm btn-outline-primary">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Stage 2</span></td>
                        <td><strong>7. Bank Account Simulator</strong></td>
                        <td>Smart Climate Wallet & HVAC heating/cooling energy bill simulator</td>
                        <td>Account domain entities, transactions balance calculation, LINQ sum</td>
                        <td><a asp-controller="Tools" asp-action="EnergyBudget" class="btn btn-sm btn-outline-primary">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">Stage 2</span></td>
                        <td><strong>8. Password Generator</strong></td>
                        <td>WeatherCrypt: High-entropy meteorological passphrases and security tokens</td>
                        <td>Cryptographic RNG, string manipulation, entropy calculations</td>
                        <td><a asp-controller="Tools" asp-action="Password" class="btn btn-sm btn-outline-primary">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">Stage 3</span></td>
                        <td><strong>9. Personal Notes Web App</strong></td>
                        <td>Weather Journal & Travel Log storing notes with ambient temperature snapshots</td>
                        <td>EF Core SQLite CRUD, LINQ full-text search, MVC Views</td>
                        <td><a asp-controller="Notes" asp-action="Index" class="btn btn-sm btn-outline-success">Launch</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">Stage 3</span></td>
                        <td><strong>10. Weather App</strong></td>
                        <td>Flagship weather station: real-time Open-Meteo API, 24h chart, 7-day forecast, export</td>
                        <td>ASP.NET Core MVC, `IHttpClientFactory`, JSON deserialization, File export</td>
                        <td><a asp-controller="Weather" asp-action="Index" class="btn btn-sm btn-modern-primary">Flagship App</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">Stage 3</span></td>
                        <td><strong>11. Contact Book API</strong></td>
                        <td>Severe weather emergency directory with full REST API (`/api/contactsapi`)</td>
                        <td>ASP.NET Core Web API, EF Core repository, HTTP methods GET/POST/PUT/DELETE</td>
                        <td><a asp-controller="Contacts" asp-action="Index" class="btn btn-sm btn-outline-success">Launch</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
