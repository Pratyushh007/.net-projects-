<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atmosphere 360 | Full-Spectrum Weather Suite</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Glassmorphism Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="glass-header">
        <nav class="navbar navbar-expand-xl navbar-dark py-3">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand me-4" asp-controller="Home" asp-action="Index">
                    <span style="font-size: 1.5rem;">🌀</span> Atmosphere 360
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1">
                        <!-- Flagship Weather App (Project 10) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Weather" asp-action="Index">
                                <i class="bi bi-cloud-sun me-1"></i> Live Weather
                            </a>
                        </li>

                        <!-- Interactive Roadmap (The 3 Stages from Image) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Roadmap">
                                <i class="bi bi-diagram-3 me-1"></i> Stages & Roadmap
                            </a>
                        </li>

                        <!-- Tools: Calculator (Project 2), Unit Converter (Project 3), Password Generator (Project 8) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sliders me-1"></i> Atmospheric Tools
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark border-secondary">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Tools" asp-action="Calculator">
                                        <i class="bi bi-calculator me-2 text-info"></i> Atmospheric Calculator <span class="badge bg-secondary ms-1">Proj 2</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Tools" asp-action="Converter">
                                        <i class="bi bi-arrow-left-right me-2 text-primary"></i> Unit Converter <span class="badge bg-secondary ms-1">Proj 3</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Tools" asp-action="Password">
                                        <i class="bi bi-shield-lock me-2 text-warning"></i> WeatherCrypt Generator <span class="badge bg-secondary ms-1">Proj 8</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Planner: To-Do List (Project 4) & Grade Manager (Project 5) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-calendar-check me-1"></i> Planner & Grades
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark border-secondary">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Planner" asp-action="Todo">
                                        <i class="bi bi-check2-circle me-2 text-success"></i> Weather-Smart To-Do <span class="badge bg-secondary ms-1">Proj 4</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Planner" asp-action="Grades">
                                        <i class="bi bi-award me-2 text-warning"></i> City Weather Report Card <span class="badge bg-secondary ms-1">Proj 5</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Games: Guessing Game (Project 1) & Quiz App (Project 6) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-controller me-1"></i> Weather Games
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark border-secondary">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Games" asp-action="GuessTemperature">
                                        <i class="bi bi-question-circle me-2 text-warning"></i> Guess the Temperature <span class="badge bg-secondary ms-1">Proj 1</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Games" asp-action="Quiz">
                                        <i class="bi bi-patch-question me-2 text-info"></i> Meteorology Quiz <span class="badge bg-secondary ms-1">Proj 6</span>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Personal Notes (Project 9) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notes" asp-action="Index">
                                <i class="bi bi-journal-text me-1"></i> Notes & Journal <span class="badge bg-secondary ms-1">Proj 9</span>
                            </a>
                        </li>

                        <!-- Bank Account & Energy (Project 7) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tools" asp-action="EnergyBudget">
                                <i class="bi bi-wallet2 me-1"></i> Energy Wallet <span class="badge bg-secondary ms-1">Proj 7</span>
                            </a>
                        </li>

                        <!-- Emergency Contacts & API (Project 11) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contacts" asp-action="Index">
                                <i class="bi bi-telephone-plus me-1"></i> Emergency Directory <span class="badge bg-secondary ms-1">Proj 11</span>
                            </a>
                        </li>
                    </ul>

                    <!-- Search Input & Quick Actions -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-xl-0">
                        <div class="search-container" style="min-width: 260px;">
                            <i class="bi bi-search search-icon-pos"></i>
                            <input type="text" id="citySearchInput" class="form-control search-input-glass" placeholder="Search any city or coordinates..." autocomplete="off">
                            <div id="citySearchDropdown" class="search-dropdown"></div>
                        </div>

                        <button id="geoLocateBtn" class="btn btn-modern-outline text-nowrap" title="Use my current GPS location">
                            <i class="bi bi-geo-alt"></i>
                        </button>

                        <button id="unitToggleBtn" class="btn btn-modern-outline text-nowrap" title="Toggle °C / °F">
                            Switch to <strong>°F</strong>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success d-flex align-items-center" role="alert" style="background: rgba(16, 185, 129, 0.2);">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-white fw-bold">Atmosphere 360</span> &bull; 
                    Full-Spectrum Weather Application & Learning Ecosystem
                    <div class="small text-muted mt-1">
                        Built with ASP.NET Core 10, Entity Framework Core & SQLite &bull; Stage 1, 2, and 3 Integration
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a asp-controller="Home" asp-action="Roadmap" class="text-secondary me-3 small"><i class="bi bi-map"></i> Curriculum Roadmap</a>
                    <a asp-controller="Contacts" asp-action="Index" class="text-secondary me-3 small"><i class="bi bi-code-slash"></i> REST API</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary small"><i class="bi bi-shield-check"></i> Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
