@model WeatherApp.Models.Tools.PasswordGeneratorModel
@{
    ViewData["Title"] = "WeatherCrypt Password Generator (Project 8)";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary">Project 8 &bull; Stage 2</span>
                <span class="badge bg-primary-subtle text-primary">Focus: Classes, Collections, LINQ, Files</span>
            </div>
            <h1 class="h3 fw-bold text-white mb-0"><i class="bi bi-shield-lock text-warning me-2"></i>WeatherCrypt Password & Passphrase Generator</h1>
        </div>
        <a asp-controller="Weather" asp-action="Index" class="btn btn-modern-outline btn-sm">
            &larr; Weather Station
        </a>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">

            <div class="glass-panel p-4 mb-4 text-center position-relative">
                <small class="text-secondary text-uppercase fw-bold">Generated High-Entropy Key</small>

                <div class="p-3 rounded-3 my-3 d-flex align-items-center justify-content-between" style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-glass);">
                    <div id="passwordText" class="fs-4 font-monospace text-warning fw-bold text-break px-2">
                        @Model.GeneratedPassword
                    </div>
                    <button class="btn btn-modern-outline btn-sm ms-2" onclick="copyToClipboard('@Model.GeneratedPassword', 'copyBtnLabel')">
                        <i class="bi bi-clipboard"></i> <span id="copyBtnLabel">Copy</span>
                    </button>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-4 text-secondary small">
                    <div><i class="bi bi-shield-check text-success me-1"></i> Strength: <strong class="text-white">@Model.StrengthRating</strong></div>
                    <div><i class="bi bi-speedometer2 text-info me-1"></i> Entropy: <strong class="text-white">@Model.EntropyBits bits</strong></div>
                    <div><i class="bi bi-hourglass-split text-warning me-1"></i> Crack Time: <strong class="text-white">@Model.CrackTimeEstimate</strong></div>
                </div>
            </div>

            <div class="glass-panel p-4">
                <h2 class="h5 fw-bold text-white mb-3">Generator Settings</h2>
                <form asp-controller="Tools" asp-action="Password" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Generator Mode</label>
                            <select name="GeneratorMode" class="form-select form-glass">
                                <option value="Passphrase" selected="@(Model.GeneratorMode == "Passphrase")">Meteorological Passphrase (Memorable & Strong)</option>
                                <option value="CrypticToken" selected="@(Model.GeneratorMode == "CrypticToken")">Cryptographic High-Entropy Token</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-bold">Token Length (Characters)</label>
                            <input type="number" name="Length" min="8" max="48" value="@Model.Length" class="form-control form-glass">
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IncludeWeatherTerms" value="true" checked="@Model.IncludeWeatherTerms" id="checkTerms">
                                <label class="form-check-label text-secondary small" for="checkTerms">Weather Lexicon</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IncludeNumbers" value="true" checked="@Model.IncludeNumbers" id="checkNums">
                                <label class="form-check-label text-secondary small" for="checkNums">Digits (0-9)</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IncludeSymbols" value="true" checked="@Model.IncludeSymbols" id="checkSyms">
                                <label class="form-check-label text-secondary small" for="checkSyms">Special Symbols</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IncludeUppercase" value="true" checked="@Model.IncludeUppercase" id="checkUpper">
                                <label class="form-check-label text-secondary small" for="checkUpper">Uppercase</label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-modern-primary w-100 py-2">
                        <i class="bi bi-arrow-repeat me-1"></i> Generate New Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
